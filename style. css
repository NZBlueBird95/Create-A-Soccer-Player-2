/* =========================================================
   FOOTBALL CAREER SIMULATOR
   REALISTIC PROFESSIONAL FOOTBALL UI
   Dark stadium • Matchday graphics • Career dashboard
   ========================================================= */

/* ---------- DESIGN SYSTEM ---------- */

:root {
  color-scheme: dark;

  --bg: #080b10;
  --bg-secondary: #0d121a;
  --panel: #111923;
  --panel-light: #182330;
  --panel-hover: #202e3d;

  --line: #2b3948;
  --line-soft: rgba(255, 255, 255, 0.075);

  --text: #f2f5f8;
  --text-secondary: #a8b4c2;
  --text-muted: #718093;

  --accent: #c6f36a;
  --accent-dark: #8fb73b;
  --accent-soft: rgba(198, 243, 106, 0.12);

  --blue: #4c9cff;
  --blue-soft: rgba(76, 156, 255, 0.12);

  --gold: #e5c16c;
  --gold-soft: rgba(229, 193, 108, 0.13);

  --red: #ff626b;
  --red-soft: rgba(255, 98, 107, 0.12);

  --green: #65d69b;
  --green-soft: rgba(101, 214, 155, 0.12);

  --radius-small: 7px;
  --radius: 12px;
  --radius-large: 18px;

  --shadow: 0 12px 35px rgba(0, 0, 0, 0.22);
  --transition: 160ms ease;
}

/* ---------- GLOBAL RESET ---------- */

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
  scrollbar-color: #354353 #080b10;
  scrollbar-width: thin;
}

body {
  min-height: 100vh;
  margin: 0;
  background:
    radial-gradient(
      ellipse at 50% -20%,
      rgba(69, 105, 129, 0.18),
      transparent 58%
    ),
    var(--bg);

  color: var(--text);
  font-family:
    Inter,
    "Segoe UI",
    Roboto,
    Helvetica,
    Arial,
    sans-serif;

  font-size: 14px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body,
button,
input,
select,
textarea {
  font-family:
    Inter,
    "Segoe UI",
    Roboto,
    Helvetica,
    Arial,
    sans-serif;
}

button,
input,
select,
textarea {
  font-size: inherit;
}

button {
  color: inherit;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: var(--accent);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

::selection {
  color: #10150b;
  background: var(--accent);
}

/* ---------- MAIN PAGE LAYOUT ---------- */

#app,
.app,
.game-container,
.container {
  width: min(1440px, 100%);
  margin-inline: auto;
}

#app,
.app {
  padding: 24px;
}

main {
  min-width: 0;
}

section {
  min-width: 0;
}

.hidden,
[hidden] {
  display: none !important;
}

/* ---------- HEADINGS ---------- */

h1,
h2,
h3,
h4 {
  margin-top: 0;
  color: var(--text);
  line-height: 1.2;
  letter-spacing: -0.035em;
}

h1 {
  margin-bottom: 12px;
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 850;
}

h2 {
  margin-bottom: 16px;
  font-size: clamp(20px, 2.5vw, 27px);
  font-weight: 800;
}

h3 {
  margin-bottom: 12px;
  font-size: 17px;
  font-weight: 750;
}

h4 {
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 700;
}

p {
  margin-top: 0;
  color: var(--text-secondary);
}

small {
  color: var(--text-muted);
  font-size: 11px;
}

strong {
  color: var(--text);
  font-weight: 750;
}

/* ---------- HEADER / NAVIGATION ---------- */

header,
.topbar,
.navbar {
  position: relative;
  z-index: 2;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;

  margin-bottom: 25px;
  padding: 16px 20px;

  background: rgba(17, 25, 35, 0.92);
  border: 1px solid var(--line);
  border-radius: var(--radius-large);

  box-shadow: var(--shadow);
  backdrop-filter: blur(16px);
}

header h1,
.topbar h1,
.navbar h1 {
  margin: 0;
  font-size: 20px;
  letter-spacing: -0.04em;
}

header p,
.topbar p,
.navbar p {
  margin: 3px 0 0;
  font-size: 12px;
}

.logo,
.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.logo-icon {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;

  color: #11170a;
  background: var(--accent);
  border-radius: 10px;

  font-weight: 950;
}

/* ---------- SECTION HEADERS ---------- */

.section-header,
.section-title,
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;

  margin-bottom: 16px;
}

.section-header h2,
.section-title h2,
.panel-header h2 {
  margin-bottom: 0;
}

.section-subtitle {
  margin: 5px 0 0;
  color: var(--text-muted);
  font-size: 12px;
}

/* ---------- GENERAL PANELS ---------- */

.panel,
.card,
.dashboard-card,
.stat-card,
.profile-card {
  min-width: 0;
  padding: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.018),
      transparent 55%
    ),
    var(--panel);

  border: 1px solid var(--line);
  border-radius: var(--radius);

  box-shadow: 0 6px 22px rgba(0, 0, 0, 0.12);
}

.panel + .panel {
  margin-top: 18px;
}

.panel:hover,
.dashboard-card:hover {
  border-color: #3a4b5d;
}

.panel p:last-child,
.card p:last-child {
  margin-bottom: 0;
}

/* ---------- GRID SYSTEM ---------- */

.grid,
.dashboard-grid,
.stats-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 16px;
}

.grid > *,
.dashboard-grid > *,
.stats-grid > * {
  min-width: 0;
}

.col-3 {
  grid-column: span 3;
}

.col-4 {
  grid-column: span 4;
}

.col-6 {
  grid-column: span 6;
}

.col-8 {
  grid-column: span 8;
}

.col-9 {
  grid-column: span 9;
}

.col-12 {
  grid-column: span 12;
}

/* ---------- CAREER DASHBOARD ---------- */

.career-dashboard {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(270px, 0.8fr);
  gap: 18px;
  align-items: start;
}

.dashboard-main,
.dashboard-sidebar {
  display: grid;
  min-width: 0;
  gap: 18px;
}

/* ---------- STADIUM / MATCHDAY HERO ---------- */

.hero,
.stadium-banner,
.matchday-banner {
  position: relative;
  isolation: isolate;
  overflow: hidden;

  padding: clamp(24px, 5vw, 42px);

  background:
    linear-gradient(
      90deg,
      rgba(5, 9, 14, 0.98),
      rgba(5, 9, 14, 0.76) 56%,
      rgba(5, 9, 14, 0.30)
    ),
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.025) 0,
      rgba(255, 255, 255, 0.025) 1px,
      transparent 1px,
      transparent 65px
    ),
    linear-gradient(125deg, #203b4d, #101b29 55%, #17231d);

  border: 1px solid #334655;
  border-radius: var(--radius-large);
  box-shadow: var(--shadow);
}

.hero::before,
.stadium-banner::before,
.matchday-banner::before {
  position: absolute;
  z-index: -1;
  inset: 0;

  background:
    radial-gradient(
      ellipse at 85% 20%,
      rgba(198, 243, 106, 0.15),
      transparent 40%
    ),
    linear-gradient(
      0deg,
      rgba(198, 243, 106, 0.035),
      transparent 65%
    );

  content: "";
}

.hero h1,
.stadium-banner h1,
.matchday-banner h1 {
  max-width: 780px;
}

.hero p,
.stadium-banner p,
.matchday-banner p {
  max-width: 650px;
}

.hero .eyebrow,
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  margin-bottom: 12px;

  color: var(--accent);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.hero .eyebrow::before {
  width: 7px;
  height: 7px;
  background: var(--accent);
  border-radius: 50%;
  content: "";
}

/* ---------- PLAYER PROFILE ---------- */

.player-profile,
.player-header {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 20px;
}

.player-avatar,
.player-portrait {
  display: grid;
  width: 104px;
  aspect-ratio: 4 / 5;
  place-items: center;

  background:
    radial-gradient(
      circle at 50% 25%,
      rgba(198, 243, 106, 0.22),
      transparent 55%
    ),
    linear-gradient(150deg, #243547, #101720);

  border: 1px solid #3b4c5d;
  border-radius: 12px;

  color: var(--accent);
  font-size: 32px;
  font-weight: 900;
}

.player-name {
  margin-bottom: 5px;
  font-size: clamp(22px, 3vw, 34px);
  font-weight: 900;
  overflow-wrap: anywhere;
}

.player-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px 12px;

  color: var(--text-secondary);
  font-size: 12px;
}

.player-meta span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.player-number {
  color: var(--text-muted);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.player-ovr,
.ovr-badge {
  display: grid;
  min-width: 76px;
  min-height: 76px;
  padding: 8px;
  place-items: center;

  background: linear-gradient(145deg, #f0d68c, #bd9344);
  border: 1px solid #f7df9c;
  border-radius: 12px;

  color: #201a0d;
  box-shadow: 0 8px 22px rgba(229, 193, 108, 0.12);
}

.player-ovr strong,
.ovr-badge strong {
  color: inherit;
  font-size: 29px;
  line-height: 1;
  font-weight: 950;
}

.player-ovr small,
.ovr-badge small {
  color: rgba(32, 26, 13, 0.8);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

/* ---------- PLAYER STAT GRID ---------- */

.attributes-grid,
.player-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 13px 20px;
}

.attribute,
.stat-row {
  min-width: 0;
}

.attribute-header,
.stat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin-bottom: 6px;
}

.attribute-label,
.stat-label {
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.attribute-value,
.stat-value {
  color: var(--text);
  font-size: 15px;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.progress,
.progress-track,
.stat-track {
  overflow: hidden;
  height: 6px;

  background: #26313e;
  border-radius: 999px;
}

.progress-bar,
.stat-bar {
  height: 100%;
  width: 0;

  background: linear-gradient(90deg, #8ebd42, var(--accent));
  border-radius: inherit;

  transition: width 350ms ease;
}

.progress-bar.blue {
  background: linear-gradient(90deg, #3477d1, var(--blue));
}

.progress-bar.gold {
  background: linear-gradient(90deg, #a77c30, var(--gold));
}

.progress-bar.red {
  background: linear-gradient(90deg, #bb3842, var(--red));
}

/* ---------- STAT SUMMARY CARDS ---------- */

.stat-card {
  position: relative;
  overflow: hidden;
}

.stat-card::after {
  position: absolute;
  right: -18px;
  bottom: -25px;

  width: 90px;
  height: 90px;

  border: 1px solid rgba(255, 255, 255, 0.035);
  border-radius: 50%;

  content: "";
  pointer-events: none;
}

.stat-card .label {
  display: block;
  margin-bottom: 8px;

  color: var(--text-muted);
  font-size: 11px;
  font-weight: 750;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.stat-card .value {
  display: block;
  color: var(--text);
  font-size: clamp(23px, 3vw, 32px);
  font-weight: 900;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.stat-card .change {
  display: block;
  margin-top: 7px;
  font-size: 11px;
}

.positive {
  color: var(--green) !important;
}

.negative {
  color: var(--red) !important;
}

.neutral {
  color: var(--text-muted) !important;
}

/* ---------- FORMS / PLAYER CREATION ---------- */

form {
  display: grid;
  gap: 17px;
}

.form-grid,
.creation-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
}

.form-group,
.field {
  display: grid;
  min-width: 0;
  gap: 7px;
}

.form-group.full,
.field.full {
  grid-column: 1 / -1;
}

label {
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 750;
}

label .required {
  color: var(--red);
}

input,
select,
textarea {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  padding: 10px 12px;

  background: #0b1119;
  border: 1px solid #334252;
  border-radius: var(--radius-small);

  color: var(--text);
  outline: none;

  transition:
    border-color var(--transition),
    box-shadow var(--transition),
    background var(--transition);
}

input::placeholder,
textarea::placeholder {
  color: #647386;
}

input:hover,
select:hover,
textarea:hover {
  border-color: #4a5d70;
}

input:focus,
select:focus,
textarea:focus {
  background: #0e1721;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

input[type="range"] {
  min-height: 24px;
  padding: 0;
  accent-color: var(--accent);
  background: transparent;
  border: 0;
  box-shadow: none;
  cursor: pointer;
}

input[type="checkbox"],
input[type="radio"] {
  width: 17px;
  min-height: 17px;
  accent-color: var(--accent);
}

input[type="number"] {
  font-variant-numeric: tabular-nums;
}

select {
  cursor: pointer;
}

textarea {
  min-height: 100px;
  resize: vertical;
}

/* ---------- CUSTOM STAT CONTROLS ---------- */

.custom-stats,
.stat-editor {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.custom-stat,
.stat-editor-item {
  display: grid;
  gap: 8px;
  padding: 13px;

  background: #0b1119;
  border: 1px solid var(--line);
  border-radius: 10px;
}

.custom-stat-header,
.stat-editor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.custom-stat-header span:first-child,
.stat-editor-header span:first-child {
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.custom-stat-value,
.stat-editor-value {
  color: var(--accent);
  font-size: 20px;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.custom-stat input[type="range"],
.stat-editor-item input[type="range"] {
  width: 100%;
}

.ovr-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;

  margin-top: 15px;
  padding: 17px;

  background: var(--accent-soft);
  border: 1px solid rgba(198, 243, 106, 0.3);
  border-radius: 10px;
}

.ovr-preview span {
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 700;
}

.ovr-preview strong {
  color: var(--accent);
  font-size: 32px;
  font-weight: 950;
}

/* ---------- BUTTONS ---------- */

button,
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  min-height: 42px;
  padding: 10px 16px;

  background: #202d3b;
  border: 1px solid #3a4b5c;
  border-radius: var(--radius-small);

  color: var(--text);
  font-weight: 800;
  font-size: 12px;
  line-height: 1.25;
  text-align: center;

  cursor: pointer;
  user-select: none;

  transition:
    background var(--transition),
    border-color var(--transition),
    color var(--transition),
    transform var(--transition),
    box-shadow var(--transition);
}

button:hover,
.btn:hover {
  background: #2b3c4e;
  border-color: #52677b;
}

button:active,
.btn:active {
  transform: translateY(1px);
}

button:focus-visible,
.btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

button:disabled,
.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  transform: none;
}

button.primary,
.btn-primary,
#createBtn {
  background: var(--accent);
  border-color: var(--accent);
  color: #141a0d;
}

button.primary:hover,
.btn-primary:hover,
#createBtn:hover {
  background: #d6ff83;
  border-color: #d6ff83;
  box-shadow: 0 5px 20px rgba(198, 243, 106, 0.13);
}

button.secondary,
.btn-secondary {
  background: var(--blue-soft);
  border-color: rgba(76, 156, 255, 0.3);
  color: #9dcaff;
}

button.danger,
.btn-danger {
  background: var(--red-soft);
  border-color: rgba(255, 98, 107, 0.3);
  color: #ff8a91;
}

button.gold,
.btn-gold {
  background: var(--gold-soft);
  border-color: rgba(229, 193, 108, 0.35);
  color: var(--gold);
}

.button-row,
.actions,
.form-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.button-row > button,
.form-actions > button {
  flex: 1 1 130px;
}

#playMatchBtn {
  background: var(--accent);
  border-color: var(--accent);
  color: #141a0d;
  font-size: 13px;
  min-height: 48px;
}

#playMatchBtn:hover {
  background: #d6ff83;
  box-shadow: 0 6px 20px rgba(198, 243, 106, 0.14);
}

#trainBtn {
  border-color: rgba(76, 156, 255, 0.35);
  background: var(--blue-soft);
  color: #9dcaff;
}

#restBtn {
  border-color: rgba(101, 214, 155, 0.3);
  background: var(--green-soft);
  color: var(--green);
}

/* ---------- CONDITION / FITNESS ---------- */

.condition-grid,
.condition-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.condition-item {
  padding: 13px 10px;
  background: #0b1119;
  border: 1px solid var(--line-soft);
  border-radius: 9px;
  text-align: center;
}

.condition-item .value {
  display: block;
  color: var(--text);
  font-size: 20px;
  font-weight: 900;
}

.condition-item .label {
  display: block;
  margin-top: 4px;
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* ---------- MATCH RESULT ---------- */

.match-result,
.match-card {
  overflow: hidden;
  background: #0b1119;
  border: 1px solid #344353;
  border-radius: var(--radius);
}

.match-result-header,
.match-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;

  padding: 13px 16px;

  background: #141d28;
  border-bottom: 1px solid var(--line);
}

.match-result-body,
.match-card-body {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  padding: 22px 16px;
}

.match-team {
  min-width: 0;
  text-align: center;
  overflow-wrap: anywhere;
}

.match-team strong {
  display: block;
  font-size: 13px;
}

.match-score {
  display: flex;
  align-items: center;
  gap: 10px;

  font-size: 31px;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}

.match-score span {
  color: var(--text-muted);
  font-size: 19px;
}

.match-performance {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;

  padding: 13px;
  border-top: 1px solid var(--line-soft);

  color: var(--text-secondary);
  font-size: 12px;
  text-align: center;
}

/* ---------- SEASON / CAREER STATISTICS ---------- */

.statistics-table,
.career-table {
  width: 100%;
  border-collapse: collapse;
  font-variant-numeric: tabular-nums;
}

.statistics-table th,
.statistics-table td,
.career-table th,
.career-table td {
  padding: 12px 10px;
  border-bottom: 1px solid var(--line-soft);
  text-align: left;
}

.statistics-table th,
.career-table th {
  color: var(--text-muted);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.statistics-table td,
.career-table td {
  color: var(--text-secondary);
  font-size: 12px;
}

.statistics-table td:last-child,
.career-table td:last-child {
  color: var(--text);
  font-weight: 800;
  text-align: right;
}

.statistics-table tr:last-child td,
.career-table tr:last-child td {
  border-bottom: 0;
}

.statistics-table tbody tr:hover,
.career-table tbody tr:hover {
  background: rgba(255, 255, 255, 0.025);
}

/* ---------- CLUB / TRANSFER OFFERS ---------- */

.offer-list,
.offers-list {
  display: grid;
  gap: 12px;
}

.offer-card {
  padding: 16px;

  background:
    linear-gradient(
      120deg,
      rgba(76, 156, 255, 0.07),
      transparent 75%
    ),
    #0d141e;

  border: 1px solid #2d4053;
  border-radius: 11px;

  transition: border-color var(--transition);
}

.offer-card:hover {
  border-color: #4d7192;
}

.offer-card strong {
  font-size: 16px;
}

.offer-card p {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  margin: 9px 0;
  font-size: 12px;
}

.offer-card button {
  width: 100%;
  margin-top: 8px;
}

/* ---------- LISTS: TROPHIES / AWARDS / HISTORY ---------- */

#trophies,
#awards,
#history,
#news,
#offers {
  display: grid;
  gap: 9px;

  color: var(--text-secondary);
  font-size: 12px;
}

.list-item,
.news-item {
  padding: 13px;

  background: #0c131c;
  border: 1px solid var(--line-soft);
  border-radius: 9px;

  overflow-wrap: anywhere;
}

.list-item {
  display: grid;
  gap: 4px;
}

.list-item strong {
  font-size: 13px;
}

.list-item span {
  color: var(--text-muted);
  font-size: 11px;
}

.list-item small {
  font-size: 10px;
}

.news-item {
  line-height: 1.5;
}

.news-item small {
  display: block;
  margin-bottom: 5px;
  color: var(--accent);
  font-weight: 800;
}

/* ---------- TROPHY ICONS / ACHIEVEMENTS ---------- */

.trophy-grid,
.achievement-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.trophy-card,
.achievement-card {
  padding: 14px 10px;
  text-align: center;

  background: #0c131c;
  border: 1px solid var(--line);
  border-radius: 10px;
}

.trophy-card .icon,
.achievement-card .icon {
  display: block;
  margin-bottom: 7px;
  font-size: 25px;
}

.trophy-card strong,
.achievement-card strong {
  display: block;
  font-size: 11px;
}

.trophy-card small,
.achievement-card small {
  display: block;
  margin-top: 4px;
}

/* ---------- FINANCIAL INFORMATION ---------- */

.finances-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.finance-item {
  padding: 14px;
  background: #0b1119;
  border: 1px solid var(--line);
  border-radius: 10px;
}

.finance-item span {
  display: block;
  color: var(--text-muted);
  font-size: 11px;
}

.finance-item strong {
  display: block;
  margin-top: 5px;
  color: var(--green);
  font-size: 20px;
  font-weight: 900;
  overflow-wrap: anywhere;
}

/* ---------- BADGES ---------- */

.badge,
.tag,
.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;

  min-height: 23px;
  padding: 3px 9px;

  background: #202d3a;
  border: 1px solid #334456;
  border-radius: 999px;

  color: var(--text-secondary);
  font-size: 10px;
  font-weight: 800;
  white-space: nowrap;
}

.badge.green,
.tag.green {
  background: var(--green-soft);
  border-color: rgba(101, 214, 155, 0.22);
  color: var(--green);
}

.badge.gold,
.tag.gold {
  background: var(--gold-soft);
  border-color: rgba(229, 193, 108, 0.22);
  color: var(--gold);
}

.badge.red,
.tag.red {
  background: var(--red-soft);
  border-color: rgba(255, 98, 107, 0.22);
  color: var(--red);
}

.badge.blue,
.tag.blue {
  background: var(--blue-soft);
  border-color: rgba(76, 156, 255, 0.22);
  color: #91c4ff;
}

/* ---------- CONTRACT / RETIREMENT ---------- */

#retirementPanel {
  padding: 28px;

  background:
    radial-gradient(
      ellipse at top,
      rgba(229, 193, 108, 0.15),
      transparent 70%
    ),
    var(--panel);

  border: 1px solid rgba(229, 193, 108, 0.45);
  border-radius: var(--radius-large);
  text-align: center;
}

#retirementPanel h2 {
  color: var(--gold);
}

/* ---------- DIVIDERS / EMPTY STATES ---------- */

hr,
.divider {
  height: 1px;
  margin: 18px 0;
  background: var(--line);
  border: 0;
}

.empty-state {
  padding: 25px 15px;
  color: var(--text-muted);
  text-align: center;
}

.muted {
  color: var(--text-muted);
}

.text-accent {
  color: var(--accent);
}

.text-gold {
  color: var(--gold);
}

.text-right {
  text-align: right;
}

/* ---------- LOADING / ANIMATION ---------- */

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(7px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.panel,
.card,
.dashboard-card {
  animation: fade-in 220ms ease both;
}

@keyframes pulse-dot {
  0%, 100% {
    opacity: 1;
  }

  50% {
    opacity: 0.45;
  }
}

.live-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: var(--red);
  border-radius: 50%;
  animation: pulse-dot 1.6s ease infinite;
}

/* ---------- RESPONSIVE: TABLETS ---------- */

@media (max-width: 1000px) {
  #app,
  .app {
    padding: 16px;
  }

  .career-dashboard {
    grid-template-columns: minmax(0, 1fr);
  }

  .dashboard-sidebar {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .dashboard-sidebar > * {
    min-width: 0;
  }

  .col-3 {
    grid-column: span 6;
  }

  .col-9 {
    grid-column: span 12;
  }
}

/* ---------- RESPONSIVE: PHONES ---------- */

@media (max-width: 620px) {
  body {
    font-size: 13px;
  }

  #app,
  .app {
    padding: 10px;
  }

  header,
  .topbar,
  .navbar {
    align-items: flex-start;
    flex-direction: column;
    padding: 15px;
  }

  .hero,
  .stadium-banner,
  .matchday-banner {
    padding: 23px 18px;
  }

  .panel,
  .card,
  .dashboard-card,
  .stat-card,
  .profile-card {
    padding: 15px;
  }

  .dashboard-sidebar {
    grid-template-columns: minmax(0, 1fr);
  }

  .grid,
  .dashboard-grid,
  .stats-grid {
    gap: 10px;
  }

  .col-3,
  .col-4,
  .col-6,
  .col-8,
  .col-9 {
    grid-column: span 12;
  }

  .player-profile,
  .player-header {
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 12px;
  }

  .player-avatar,
  .player-portrait {
    width: 72px;
  }

  .player-ovr,
  .ovr-badge {
    grid-column: 1 / -1;
    display: flex;
    min-height: auto;
    min-width: 0;
    justify-content: center;
    gap: 8px;
    padding: 12px;
  }

  .player-ovr strong,
  .ovr-badge strong {
    font-size: 24px;
  }

  .attributes-grid,
  .player-stats-grid,
  .form-grid,
  .creation-grid,
  .custom-stats,
  .stat-editor {
    grid-template-columns: minmax(0, 1fr);
  }

  .condition-grid,
  .condition-cards {
    gap: 6px;
  }

  .condition-item {
    padding: 11px 6px;
  }

  .condition-item .value {
    font-size: 17px;
  }

  .button-row,
  .actions,
  .form-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .button-row > button,
  .form-actions > button {
    width: 100%;
    min-width: 0;
  }

  .match-result-body,
  .match-card-body {
    gap: 6px;
    padding: 17px 8px;
  }

  .match-team strong {
    font-size: 11px;
  }

  .match-score {
    gap: 6px;
    font-size: 25px;
  }

  .statistics-table th,
  .statistics-table td,
  .career-table th,
  .career-table td {
    padding: 9px 6px;
    font-size: 10px;
  }

  .trophy-grid,
  .achievement-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ---------- REDUCED MOTION ACCESSIBILITY ---------- */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
