      input.min = 1;
      input.max = 99;
      input.addEventListener("input", updateCustomStatPreview);
    }
  }
}

/* ---------------------------------------------------------
   PLAYER CREATION
   --------------------------------------------------------- */

function createCareer() {
  const name = $("name")?.value?.trim() || "The Phantom";

  const nationality = $("nationality")?.value || "New Zealand";
  const position = normalisePosition($("position")?.value || "LW");
  const foot = $("foot")?.value || "Right";
  const age = clamp(Number($("age")?.value) || 18, 15, 45);
  const height = clamp(Number($("height")?.value) || 180, 140, 220);
  const number = clamp(Number($("number")?.value) || 10, 1, 99);

  const stats = readCustomStats();
  const ovr = calculateOVR(stats, position);

  player = createPlayerObject({
    name,
    nationality,
    position,
    foot,
    age,
    height,
    number,
    stats,
    potential: calculatePotential(age, ovr)
  });

  currentYear = new Date().getFullYear();
  currentSeason = currentYear;
  seasonFinished = false;
  retirement = false;

  currentClub = chooseStartingClub(player.ovr, player.nationality);
  player.salary = calculateSalary(player.ovr, currentClub);
  player.marketValue = calculateMarketValue(player);
  player.contractYears = randomInt(2, 4);

  player.clubHistory.push({
    club: currentClub.name,
    startYear: currentYear,
    endYear: null,
    appearances: 0,
    goals: 0,
    assists: 0,
    trophies: []
  });

  addNews(
    `${player.name} begins a professional career at ${currentClub.name}.`
  );

  safeShow("createScreen", false);
  safeShow("careerScreen", true);

  renderAll();
  saveCareer(false);
}

function chooseStartingClub(ovr, nationality) {
  let suitable = CLUBS.filter(club => club.rating <= ovr + 10);

  if (ovr < 65) {
    suitable = suitable.filter(club => club.rating <= 75);
  } else if (ovr < 75) {
    suitable = suitable.filter(club => club.rating <= 85);
  }

  if (!suitable.length) suitable = CLUBS;

  const preferred = player?.preferredClub;
  if (preferred) {
    const club = CLUBS.find(item => item.name === preferred);
    if (club && club.rating <= ovr + 15) return club;
  }

  const localClubs = suitable.filter(
    club => club.country === nationality
  );

  if (localClubs.length && Math.random() < 0.35) {
    return pick(localClubs);
  }

  const lowerBound = Math.max(50, ovr - 20);
  const candidates = suitable.filter(
    club => club.rating >= lowerBound
  );

  return pick(candidates.length ? candidates : suitable);
}

/* ---------------------------------------------------------
   VALUE, WAGES AND CONTRACTS
   --------------------------------------------------------- */

function calculateMarketValue(p) {
  if (!p) return 0;

  const ovr = p.ovr;
  const ageFactor = p.age < 21 ? 1.3 :
                    p.age < 25 ? 1.5 :
                    p.age < 29 ? 1.2 :
                    p.age < 32 ? 0.75 : 0.35;

  const potentialFactor = 1 + Math.max(0, p.potential - ovr) * 0.035;
  const reputationFactor = 0.7 + p.reputation / 20;
  const performanceFactor = 1 + clamp(p.season.goals * 0.008, 0, 0.5)
                              + clamp(p.season.assists * 0.005, 0, 0.3);

  const base = Math.max(5000, (ovr ** 3) * 15);

  return Math.round(
    base * ageFactor * potentialFactor *
    reputationFactor * performanceFactor
  );
}

function calculateSalary(ovr, club) {
  const clubFactor = Math.max(0.35, club.rating / 85);
  return Math.round((ovr ** 3) * 0.2 * clubFactor);
}

function updateFinancials() {
  if (!player || !currentClub) return;

  player.marketValue = calculateMarketValue(player);
  player.salary = calculateSalary(player.ovr, currentClub);
}

/* ---------------------------------------------------------
   PLAYER EFFECTIVE ABILITY
   --------------------------------------------------------- */

function effectiveStat(stat) {
  if (!player) return 50;

  const raw = player.stats[stat] || 50;
  const fitnessFactor = 0.70 + player.fitness / 333;
  const sharpnessFactor = 0.85 + player.sharpness / 500;
  const formFactor = 1 + clamp(player.form, -10, 10) * 0.008;

  let ageFactor = 1;

  if (player.age >= 34 && ["pac", "phy"].includes(stat)) {
    ageFactor -= (player.age - 33) * 0.012;
  }

  return clamp(
    raw * fitnessFactor * sharpnessFactor * formFactor * ageFactor,
    1,
    99
  );
}

function effectiveOVR() {
  const stats = {};

  for (const stat of STAT_NAMES) {
    stats[stat] = effectiveStat(stat);
  }

  return calculateOVR(stats, player.position);
}

/* ---------------------------------------------------------
   MATCH ENGINE
   --------------------------------------------------------- */

function playerRoleMultiplier(position) {
  if (["ST", "LW", "RW", "CAM"].includes(position)) return 1.1;
  if (["CM", "CDM"].includes(position)) return 0.8;
  if (["LB", "RB", "CB"].includes(position)) return 0.45;
  if (position === "GK") return 0.05;
  return 0.7;
}

function expectedGoals(teamRating, opponentRating, home = false) {
  const difference = teamRating - opponentRating + (home ? 3 : 0);
  return clamp(1.35 + difference * 0.035, 0.25, 3.2);
}

function poissonSample(lambda) {
  const limit = Math.exp(-lambda);
  let product = 1;
  let count = 0;

  do {
    count++;
    product *= Math.random();
  } while (product > limit && count < 12);

  return count - 1;
}

function playMatch() {
  if (!player || !currentClub || player.retired) {
    notify("Create or load a career first.");
    return;
  }

  if (seasonFinished) {
    notify("This season has finished. Advance to the next season first.");
    return;
  }

  if (player.injuryDays > 0) {
    notify(`You are injured for another ${player.injuryDays} day(s). Rest to recover.`);
    return;
  }

  if (player.suspendedMatches > 0) {
    player.suspendedMatches--;
    notify("You are suspended for this match.");
    return;
  }

  const opponent = chooseOpponent(currentClub);
  const isHome = Math.random() < 0.5;
  const homeName = isHome ? currentClub.name : opponent.name;
  const awayName = isHome ? opponent.name : currentClub.name;

  const playerOVR = effectiveOVR();
  const startChance = clamp(
    0.35 + (playerOVR - currentClub.rating + 10) * 0.035
      + player.sharpness / 300,
    0.08,
    0.97
  );

  const starts = Math.random() < startChance;
  const minutes = starts ? randomInt(65, 90) :
                  Math.random() < 0.55 ? randomInt(10, 35) : 0;

  const homeRating = isHome ? currentClub.rating : opponent.rating;
  const awayRating = isHome ? opponent.rating : currentClub.rating;

  let homeXG = expectedGoals(homeRating, awayRating, true);
  let awayXG = expectedGoals(awayRating, homeRating, false);

  if (minutes === 0) {
    homeXG *= 0.95;
    awayXG *= 0.95;
  }

  let homeGoals = poissonSample(homeXG);
  let awayGoals = poissonSample(awayXG);

  let goals = 0;
  let assists = 0;
  let rating = minutes === 0 ? 5.8 : random(5.8, 7.0);

  if (minutes > 0) {
    const role = playerRoleMultiplier(player.position);
    const attack = (
      effectiveStat("sho") * 0.36 +
      effectiveStat("pac") * 0.18 +
      effectiveStat("dri") * 0.20 +
      effectiveStat("pas") * 0.14 +
      effectiveStat("phy") * 0.12
    ) / 100;

    const opportunityRate = minutes / 90;
    const clubFactor = clamp(
      0.7 + (currentClub.rating - opponent.rating) * 0.018,
      0.45,
      1.4
    );

    let goalChance = role * attack * opportunityRate * clubFactor * 0.6;
    goalChance *= player.form >= 4 ? 1.15 : 1;
    goalChance *= player.morale >= 80 ? 1.05 : 1;
    goalChance *= player.fitness / 100;

    goals = 0;
    for (let i = 0; i < 4; i++) {
      if (Math.random() < goalChance * 0.32) goals++;
    }

    const playmakerFactor = effectiveStat("pas") / 100;
    const assistChance = (minutes / 90) * role *
      (0.08 + playmakerFactor * 0.18) * clubFactor;

    assists = 0;
    for (let i = 0; i < 3; i++) {
      if (Math.random() < assistChance) assists++;
    }

    if (goals > 0) {
      if (isHome) homeGoals += goals;
      else awayGoals += goals;
    }

    if (starts) player.season.starts++;
    else player.season.substituteAppearances++;

    rating = clamp(
      6.0 + goals * 1.25 + assists * 0.75 +
      random(-0.8, 0.9) +
      (starts ? 0.2 : 0),
      4.5,
      10
    );

    player.fitness = clamp(
      player.fitness - (starts ? randomInt(9, 16) : randomInt(3, 8)),
      15,
      100
    );

    player.sharpness = clamp(player.sharpness + 3, 0, 100);
  } else {
    player.fitness = clamp(player.fitness - randomInt(1, 3), 15, 100);
  }

  const won = (
    (isHome && homeGoals > awayGoals) ||
    (!isHome && awayGoals > homeGoals)
  );

  const draw = homeGoals === awayGoals;

  if (minutes > 0) {
    player.season.matches++;
    player.career.matches++;
    player.season.goals += goals;
    player.career.goals += goals;
    player.season.assists += assists;
    player.career.assists += assists;
    player.season.minutes += minutes;
    player.career.minutes += minutes;

    player.season.averageRating = updateAverage(
      player.season.averageRating,
      rating,
      player.season.matches
    );

    player.career.averageRating = updateAverage(
      player.career.averageRating,
      rating,
      player.career.matches
    );

    player.form = clamp(
      player.form + (rating >= 7 ? 1 : rating < 6 ? -1 : 0),
      -10,
      10
    );

    if (won) {
      player.morale = clamp(player.morale + 3, 0, 100);
    } else if (!draw) {
      player.morale = clamp(player.morale - 2, 0, 100);
    }

    const yellow = Math.random() < 0.12;
    if (yellow) {
      player.season.yellowCards++;
      player.career.yellowCards++;
    }

    if (Math.random() < 0.012) {
      player.injuryDays = randomInt(3, 28);
      addNews(`${player.name} picked up an injury and will need recovery time.`);
    }

    player.reputation = clamp(
      player.reputation + (rating >= 8.5 ? 1 : rating >= 7.5 ? 0.3 : 0),
      0,
      100
    );
  }

  player.cash += player.salary / 4;
  updateFinancials();

  const result = {
    year: currentYear,
    club: currentClub.name,
    opponent: opponent.name,
    home: isHome,
    homeName,
    awayName,
    homeGoals,
    awayGoals,
    goals,
    assists,
    rating: round(rating, 1),
    minutes,
    starts,
    won,
    draw,
    date: new Date().toISOString()
  };

  lastMatch = result;
  player.matchHistory.unshift(result);
  player.matchHistory = player.matchHistory.slice(0, 30);

  addNews(
    minutes > 0
      ? `${player.name} played ${minutes} minutes against ${opponent.name}, rating ${round(rating, 1)}.`
      : `${player.name} did not get on the pitch against ${opponent.name}.`
  );

  renderAll();
  saveCareer(false);
}

function updateAverage(previous, newRating, count) {
  if (count <= 1) return newRating;
  return ((previous * (count - 1)) + newRating) / count;
}

function chooseOpponent(club) {
  let opponents = CLUBS.filter(item =>
    item.name !== club.name &&
    item.league === club.league
  );

  if (!opponents.length) {
    opponents = CLUBS.filter(item => item.name !== club.name);
  }

  const close = opponents.filter(item =>
    Math.abs(item.rating - club.rating) <= 8
  );

  return pick(close.length ? close : opponents);
}

/* ---------------------------------------------------------
   TRAINING AND RECOVERY
   --------------------------------------------------------- */

function trainPlayer() {
  if (!player || player.retired) {
    notify("Create or load a career first.");
    return;
  }

  if (player.injuryDays > 0) {
    notify("Recover from your injury before training.");
    return;
  }

  if (player.fitness < 35) {
    notify("Your fitness is too low for intense training. Rest first.");
    return;
  }

  const stat = chooseTrainingStat();
  const age = player.age;
  const potentialGap = player.potential - player.stats[stat];

  let improvement = 0;

  if (potentialGap > 0) {
    const ageFactor = age <= 21 ? 1.4 :
                      age <= 25 ? 1 :
                      age <= 29 ? 0.55 : 0.2;

    improvement = random(0.15, 0.65) * ageFactor;
    improvement *= player.morale > 70 ? 1.1 : 0.9;
    improvement = Math.min(improvement, potentialGap);
  }

  player.stats[stat] = round(
    clamp(player.stats[stat] + improvement, 1, 99),
    1
  );

  player.fitness = clamp(player.fitness - randomInt(7, 13), 15, 100);
  player.sharpness = clamp(player.sharpness + randomInt(4, 8), 0, 100);
  player.morale = clamp(player.morale + 1, 0, 100);

  player.ovr = calculateOVR(player.stats, player.position);
  updateFinancials();

  addNews(
    `Training complete: ${STAT_LABELS[stat]} ${improvement > 0 ? "+" + round(improvement, 1) : "maintained"}.`
  );

  renderAll();
  saveCareer(false);
}

function chooseTrainingStat() {
  const weights = POSITION_WEIGHTS[player.position];
  const entries = STAT_NAMES.map(stat => ({
    stat,
    weight: Math.max(0.05, weights[stat])
  }));

  let total = entries.reduce((sum, item) => sum + item.weight, 0);
  let roll = Math.random() * total;

  for (const item of entries) {
    roll -= item.weight;
    if (roll <= 0) return item.stat;
  }

  return "pac";
}

function restPlayer() {
  if (!player || player.retired) {
    notify("Create or load a career first.");
    return;
  }

  player.fitness = clamp(player.fitness + randomInt(18, 30), 0, 100);
  player.sharpness = clamp(player.sharpness - 1, 0, 100);
  player.morale = clamp(player.morale + 2, 0, 100);

  if (player.injuryDays > 0) {
    player.injuryDays = Math.max(0, player.injuryDays - randomInt(3, 7));

    if (player.injuryDays === 0) {
      addNews(`${player.name} has recovered from their injury.`);
    }
  }

  addNews(`${player.name} took a recovery day.`);
  renderAll();
  saveCareer(false);
}

/* ---------------------------------------------------------
   SEASON PROGRESSION
   --------------------------------------------------------- */

function advanceSeason() {
  if (!player || player.retired) {
    notify("Create or load a career first.");
    return;
  }

  const confirmation = player.season.matches === 0
    ? true
    : confirm("Finish this season and advance to the next year?");

  if (!confirmation) return;

  finishSeason();

  if (player.age >= 40) {
    player.retired = true;
    retirement = true;
    safeShow("retirementPanel", true);
    addNews(`${player.name} has retired from professional football.`);
    renderAll();
    saveCareer(false);
    return;
  }

  currentYear++;
  currentSeason = currentYear;
  player.age++;
  player.seasonsPlayed++;
  seasonFinished = false;

  player.season = createEmptyStats();
  player.seasonTrophies = [];
  player.seasonStarts = 0;

  player.fitness = clamp(player.fitness + 25, 50, 100);
  player.sharpness = 55;
  player.form = Math.round(player.form * 0.4);
  player.morale = clamp(player.morale + randomInt(-5, 8), 25, 100);
  player.contractYears = Math.max(0, player.contractYears - 1);

  developAtSeasonEnd();
  updateFinancials();

  if (player.injuryDays > 0) {
    player.injuryDays = Math.max(0, player.injuryDays - 30);
  }

  if (player.contractYears === 0) {
    player.contractYears = randomInt(2, 4);
    addNews(`${player.name} signed a renewed contract with ${currentClub.name}.`);
  }

  if (currentYear % 4 === 2) {
    simulateWorldCup();
  }

  generateTransferOffers();
  maybeGiveSeasonAward();

  addNews(`The ${currentYear} season begins.`);
  renderAll();
  saveCareer(false);
}

function finishSeason() {
  if (!player || seasonFinished) return;

  seasonFinished = true;

  const clubPerformance = currentClub.rating;
  const playerPerformance = player.ovr;

  // Domestic league title probability depends on club strength.
  const titleChance = clamp(
    0.08 + (clubPerformance - 65) * 0.012 +
    (playerPerformance - clubPerformance) * 0.006,
    0.02,
    0.72
  );

  if (Math.random() < titleChance) {
    awardTrophy(`${currentClub.league} title`, currentYear);
  }

  if (Math.random() < titleChance * 0.4) {
    awardTrophy("Domestic Cup", currentYear);
  }

  if (currentClub.europe && currentClub.rating >= 82 &&
      Math.random() < clamp((currentClub.rating - 76) * 0.025, 0.05, 0.45)) {
    awardTrophy("European Competition", currentYear);
  }

  const goals = player.season.goals;
  const assists = player.season.assists;
  const appearances = player.season.matches;

  if (appearances >= 10 && goals >= 15) {
    awardAward("Golden Boot", currentYear);
  }

  if (appearances >= 10 && assists >= 12) {
    awardAward("Playmaker of the Season", currentYear);
  }

  if (appearances >= 15 && player.season.averageRating >= 7.6) {
    awardAward("Team of the Season", currentYear);
  }

  if (player.ovr >= 90 && player.reputation >= 70 &&
      appearances >= 20 && Math.random() < 0.5) {
    awardAward("Ballon d'Or", currentYear);
  }

  const history = player.clubHistory[player.clubHistory.length - 1];

  if (history) {
    history.appearances += appearances;
    history.goals += goals;
    history.assists += assists;
    history.endYear = currentYear;
    history.trophies.push(...player.seasonTrophies);
  }

  player.cash += player.salary * 2;
  player.lastSeasonOVR = player.ovr;

  addNews(
    `${currentYear} season finished: ${goals} goals and ${assists} assists in ${appearances} appearances.`
  );
}

function developAtSeasonEnd() {
  for (const stat of STAT_NAMES) {
    const current = player.stats[stat];
    const potentialGap = player.potential - current;

    if (potentialGap <= 0) continue;

    let change = 0;

    if (player.age <= 20) change = random(0.3, 1.5);
    else if (player.age <= 24) change = random(0.2, 1.0);
    else if (player.age <= 28) change = random(0.0, 0.5);
    else if (player.age <= 32) change = random(-0.2, 0.25);
    else change = random(-1.2, 0.0);

    if (player.fitness < 50) change -= 0.2;
    if (player.morale > 80 && change > 0) change += 0.1;

    player.stats[stat] = round(
      clamp(current + change, 1, 99),
      1
    );
  }

  if (player.age >= 30) {
    player.stats.pac = round(
      clamp(player.stats.pac - random(0, 0.8), 1, 99),
      1
    );
    player.stats.phy = round(
      clamp(player.stats.phy - random(0, 0.6), 1, 99),
      1
    );
  }

  player.ovr = calculateOVR(player.stats, player.position);
}

