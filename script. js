function createPlayerObject(data) {
  const stats = {};

  for (const stat of STAT_NAMES) {
    stats[stat] = clamp(Number(data.stats?.[stat]) || 50, 1, 99);
  }

  const position = normalisePosition(data.position);

  const age = clamp(Number(data.age) || 18, 15, 45);

  return {
    name: String(data.name || "New Player").trim().slice(0, 40),
    nationality: data.nationality || "New Zealand",
    age,
    birthYear: currentYear - age,
    height: clamp(Number(data.height) || 180, 140, 220),
    foot: data.foot || "Right",
    position,
    number: clamp(Number(data.number) || 10, 1, 99),

    stats,
    ovr: calculateOVR(stats, position),
    potential: clamp(
      Number(data.potential) || calculateOVR(stats, position) + randomInt(4, 12),
      calculateOVR(stats, position),
      99
    ),

    fitness: 95,
    form: 0,
    morale: 75,
    sharpness: 65,
    injuryDays: 0,
    suspendedMatches: 0,

    reputation: 5,
    loyalty: 50,
    marketValue: 50000,
    salary: 1000,
    cash: 0,
    contractYears: 2,

    preferredClub: data.preferredClub || null,
    appearancesForCountry: 0,
    internationalGoals: 0,
    internationalAssists: 0,
    nationalTeamSelected: false,

    season: createEmptyStats(),
    career: createEmptyStats(),
    seasonTrophies: [],
    trophies: [],
    awards: [],
    clubHistory: [],
    news: [],
    matchHistory: [],

    seasonStarts: 0,
    seasonsPlayed: 0,
    lastSeasonOVR: calculateOVR(stats, position),
    retired: false,
    createdAt: currentYear
  };
}

function calculatePotential(age, ovr) {
  let bonus;

  if (age <= 18) bonus = randomInt(10, 20);
  else if (age <= 21) bonus = randomInt(7, 16);
  else if (age <= 24) bonus = randomInt(4, 12);
  else if (age <= 28) bonus = randomInt(1, 8);
  else bonus = randomInt(0, 4);

  return clamp(ovr + bonus, ovr, 99);
}

