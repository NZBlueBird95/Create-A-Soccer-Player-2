  safeText("careerGoals", player.career.goals);
  safeText("careerAssists", player.career.assists);
  safeText("internationalCaps", player.appearancesForCountry);
  safeText("internationalGoals", player.internationalGoals);
  safeText("trophyCount", player.trophies.length);
  safeText("awardCount", player.awards.length);
