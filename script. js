  element.innerHTML = player.awards
    .slice()
    .reverse()
    .map(award =>
      `<div class="list-item">
        🥇 <strong>${escapeHTML(award.name)}</strong>
        <span>${escapeHTML(award.year)}</span>
      </div>`
