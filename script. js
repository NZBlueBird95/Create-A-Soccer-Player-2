  if (!player || !currentClub) return;

  player.ovr = calculateOVR(player.stats, player.position);
  updateFinancials();

  renderProfile();
  renderAttributes();
  renderCondition();
  renderSeasonStats();
  renderCareerStats();
  renderLatestMatch();
  renderTrophies();
  renderAwards();
  renderHistory();
  renderNews();
  renderOffers();

  safeText("year", currentYear);
  safeShow("retirementPanel", player.retired);
}

function renderProfile() {
  const country = getCountry(player.nationality);

  safeText("displayNumber", player.number);
  safeText("displayName", player.name);
  safeText("displayPosition", POSITION_NAMES[player.position] || player.position);
  safeText("displayNationality", `${country.flag} ${country.name}`);
  safeText("displayClub", currentClub.name);
  safeText("displayAge", player.age);
  safeText("displayHeight", `${player.height} cm`);
  safeText("displayFoot", player.foot);
  safeText("displayOVR", player.ovr);
  safeText("displayPotential", player.potential);

  safeText("displayValue", formatMoney(player.marketValue));
  safeText("displaySalary", `${formatMoney(player.salary)}/week`);
