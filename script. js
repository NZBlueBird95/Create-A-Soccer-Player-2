function renderSeasonStats() {
  safeText("seasonMatches", player.season.matches);
  safeText("seasonStarts", player.season.starts);
  safeText("seasonGoals", player.season.goals);
  safeText("seasonAssists", player.season.assists);
  safeText(
    "seasonRating",
    player.season.matches
      ? round(player.season.averageRating, 2)
      : "—"
  );
}

function renderCareerStats() {
