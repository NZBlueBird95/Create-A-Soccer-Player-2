  LW: "Left winger",
  RW: "Right winger",
  ST: "Striker"
};

function normalisePosition(position) {
  const value = String(position || "ST").toUpperCase().trim();

  const aliases = {
    "GOALKEEPER": "GK",
    "CENTRE BACK": "CB",
    "CENTER BACK": "CB",
    "LEFT BACK": "LB",
    "RIGHT BACK": "RB",
    "DEFENSIVE MIDFIELDER": "CDM",
    "CENTRAL MIDFIELDER": "CM",
    "ATTACKING MIDFIELDER": "CAM",
    "LEFT WINGER": "LW",
    "RIGHT WINGER": "RW",
    "STRIKER": "ST"
  };

  const result = aliases[value] || value;
  return POSITION_WEIGHTS[result] ? result : "ST";
}

function calculateOVR(stats, position) {
  const weights = POSITION_WEIGHTS[normalisePosition(position)];

  let total = 0;

  for (const stat of STAT_NAMES) {
    total += clamp(Number(stats[stat]) || 1, 1, 99) * weights[stat];
  }

  return clamp(Math.round(total), 1, 99);
}

function readCustomStats() {
  const stats = {};

  for (const stat of STAT_NAMES) {
    const input = $(stat + "Input");
    stats[stat] = clamp(
      Number(input ? input.value : 70) || 1,
      1,
      99
    );
  }

  return stats;
}

function updateCustomStatPreview() {
  const stats = readCustomStats();

  for (const stat of STAT_NAMES) {
    safeText(stat + "Value", stats[stat]);
  }

  const position = normalisePosition(
    $("position")?.value || "ST"
  );

  safeText("previewOVR", calculateOVR(stats, position));
}

