function awardTrophy(name, year) {
  const trophy = { name, year, club: currentClub.name };

  player.trophies.push(trophy);
  player.seasonTrophies.push(trophy);

  addNews(`${currentClub.name} won the ${name}!`);
}

function awardAward(name, year) {
  player.awards.push({
    name,
    year,
    club: currentClub.name
  });

  addNews(`${player.name} won ${name}!`);
}

function maybeGiveSeasonAward() {
  if (
    player.ovr >= 92 &&
    player.reputation >= 80 &&
    player.season.matches >= 20 &&
    player.season.averageRating >= 7.7 &&
    Math.random() < 0.35
  ) {
    awardAward("World Player of the Year", currentYear);
  }
}

/* ---------------------------------------------------------
   INTERNATIONAL FOOTBALL

   Simplified international simulation. It is not an official
   real-world tournament schedule.
   --------------------------------------------------------- */

function simulateWorldCup() {
  const country = getCountry(player.nationality);

  const selectionChance = clamp(
    0.12 + (player.ovr - country.rating) * 0.035 +
    player.reputation * 0.004,
    0.02,
    0.98
  );

  if (Math.random() > selectionChance) {
    addNews(
      `${player.nationality} did not select ${player.name} for this World Cup.`
    );
    return;
  }

  player.nationalTeamSelected = true;
  player.appearancesForCountry += randomInt(3, 7);

  const attackAbility = (
    player.stats.sho + player.stats.pas + player.stats.dri
  ) / 3;

  const internationalGoals = Math.random() < attackAbility / 100
    ? randomInt(0, 4)
    : randomInt(0, 1);

  player.internationalGoals += internationalGoals;
  player.internationalAssists += randomInt(0, 2);

  const strength = country.rating + (player.ovr - 75) * 0.15;
  const championChance = clamp((strength - 55) * 0.0012, 0.005, 0.13);

  if (Math.random() < championChance) {
    awardInternationalTrophy("FIFA World Cup");
    awardAward("World Cup Winner", currentYear);
    addNews(`${player.nationality} won the World Cup!`);
  } else {
    addNews(
      `${player.name} represented ${player.nationality} at the World Cup.`
    );
  }
}

function awardInternationalTrophy(name) {
  player.trophies.push({
    name,
    year: currentYear,
    club: player.nationality
  });
}

/* ---------------------------------------------------------
   TRANSFERS
   --------------------------------------------------------- */

function generateTransferOffers() {
  offerList = [];

  const value = player.marketValue;
  const reputation = player.reputation;

  const suitable = CLUBS.filter(club => {
    if (club.name === currentClub.name) return false;

    const ratingLimit = player.ovr + (reputation > 50 ? 8 : 3);
    const canAfford = club.budget >= value * 0.6;

    return club.rating <= ratingLimit && canAfford;
  });

  const sorted = suitable.sort((a, b) => {
    const scoreA = a.rating + a.prestige * 0.15;
    const scoreB = b.rating + b.prestige * 0.15;
    return scoreB - scoreA;
  });

  const choices = sorted.slice(0, 12);

  while (offerList.length < 3 && choices.length) {
    const club = choices.splice(randomInt(0, choices.length - 1), 1)[0];

    offerList.push({
      club,
      fee: Math.round(value * random(0.8, 1.35)),
      salary: calculateSalary(player.ovr, club),
      contractYears: randomInt(2, 5)
    });
  }
}

function acceptTransfer(index) {
  if (!player || player.retired) return;

  const offer = offerList[index];
  if (!offer) {
    notify("That transfer offer is no longer available.");
    return;
  }

  const oldClub = currentClub;
  const oldHistory = player.clubHistory[player.clubHistory.length - 1];

  if (oldHistory) oldHistory.endYear = currentYear;

  currentClub = offer.club;
  player.cash += offer.fee * 0.02;
  player.salary = offer.salary;
  player.contractYears = offer.contractYears;
  player.loyalty = 50;

  player.clubHistory.push({
    club: currentClub.name,
    startYear: currentYear,
    endYear: null,
    appearances: 0,
    goals: 0,
    assists: 0,
    trophies: []
  });

  offerList = [];

  addNews(
    `${player.name} transferred from ${oldClub.name} to ${currentClub.name} for ${formatMoney(offer.fee)}.`
  );

  renderAll();
  saveCareer(false);
}

