  element.innerHTML = player.trophies
    .slice()
    .reverse()
    .map(trophy =>
      `<div class="list-item">
        🏆 <strong>${escapeHTML(trophy.name)}</strong>
        <span>${escapeHTML(trophy.year)}</span>
        <small>${escapeHTML(trophy.club)}</small>
      </div>`
    )
    .join("");
}

function renderAwards() {
  const element = $("awards");
  if (!element) return;

  if (!player.awards.length) {
    element.textContent = "No individual awards yet.";
    return;
