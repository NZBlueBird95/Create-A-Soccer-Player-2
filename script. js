function renderNews() {
  const element = $("news");
  if (!element) return;

  if (!player.news.length) {
    element.textContent = "No news yet.";
    return;
  }

  element.innerHTML = player.news
    .slice(0, 15)
    .map(item =>
      `<div class="news-item">
        <small>${escapeHTML(item.year)}</small>
        ${escapeHTML(item.message)}
      </div>`
    )
    .join("");
}

function renderOffers() {
  const element = $("offers");
  if (!element) return;

  if (!offerList.length) {
    element.textContent = "No transfer offers available right now.";
    return;
  }

  element.innerHTML = offerList.map((offer, index) => `
    <div class="offer-card">
      <strong>${escapeHTML(offer.club.name)}</strong>
      <p>Club OVR: ${offer.club.rating}</p>
      <p>Transfer fee: ${formatMoney(offer.fee)}</p>
      <p>Weekly wage: ${formatMoney(offer.salary)}</p>
      <p>Contract: ${offer.contractYears} years</p>
      <button type="button" data-transfer-index="${index}">
        Accept transfer
      </button>
    </div>
  `).join("");

  element.querySelectorAll("[data-transfer-index]").forEach(button => {
    button.addEventListener("click", () => {
      acceptTransfer(Number(button.dataset.transferIndex));
    });
  });
}

/* ---------------------------------------------------------
   SAVE AND LOAD
   --------------------------------------------------------- */

function saveCareer(showMessage = true) {
  if (!player || !currentClub) {
    if (showMessage) notify("There is no career to save.");
    return;
  }

  const saveData = {
    version: GAME_VERSION,
    currentYear,
    currentSeason,
    seasonFinished,
    player,
    currentClubName: currentClub.name,
    lastMatch,
    offerList: offerList.map(offer => ({
      clubName: offer.club.name,
      fee: offer.fee,
      salary: offer.salary,
      contractYears: offer.contractYears
    }))
  };

  try {
    localStorage.setItem(SAVE_KEY, JSON.stringify(saveData));
    if (showMessage) notify("Career saved successfully!");
  } catch (error) {
    console.error("Save failed:", error);
    if (showMessage) {
      notify("Save failed. Your browser may be blocking local storage.");
    }
  }
}

function loadCareer() {
  let raw;

  try {
    raw = localStorage.getItem(SAVE_KEY);
  } catch (error) {
    notify("Your browser would not allow the saved career to be read.");
    return;
  }

  if (!raw) {
    notify("No saved career found in this browser.");
    return;
  }

  try {
    const data = JSON.parse(raw);

    if (!data.player || !data.currentClubName) {
      throw new Error("Invalid save data");
    }

    currentYear = Number(data.currentYear) || new Date().getFullYear();
    currentSeason = Number(data.currentSeason) || currentYear;
    seasonFinished = Boolean(data.seasonFinished);
    player = data.player;
    currentClub = CLUBS.find(
      club => club.name === data.currentClubName
    );

    if (!currentClub) throw new Error("Saved club not found");

    // Fill missing fields if loading an older save.
    player.stats ||= readCustomStats();
    player.season ||= createEmptyStats();
    player.career ||= createEmptyStats();
    player.trophies ||= [];
    player.awards ||= [];
    player.clubHistory ||= [];
    player.news ||= [];
    player.matchHistory ||= [];
    player.seasonTrophies ||= [];
    player.age = clamp(Number(player.age) || 18, 15, 45);
    player.position = normalisePosition(player.position);
    player.ovr = calculateOVR(player.stats, player.position);

    lastMatch = data.lastMatch || null;

    offerList = (data.offerList || [])
      .map(savedOffer => {
        const club = CLUBS.find(
          item => item.name === savedOffer.clubName
        );

        return club ? {
          club,
          fee: savedOffer.fee,
          salary: savedOffer.salary,
          contractYears: savedOffer.contractYears
        } : null;
      })
      .filter(Boolean);

    retirement = Boolean(player.retired);

    safeShow("createScreen", false);
    safeShow("careerScreen", true);

    renderAll();
    notify("Career loaded successfully!");
  } catch (error) {
    console.error("Load failed:", error);
    notify("That save could not be loaded. It may be damaged or outdated.");
  }
}

