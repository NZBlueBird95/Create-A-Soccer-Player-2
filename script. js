function addNews(message) {
  if (!player) {
    console.log(message);
    return;
  }

  player.news.unshift({
    year: currentYear,
    message: String(message),
    date: new Date().toISOString()
  });

  player.news = player.news.slice(0, 60);
}

function notify(message) {
  // Uses a simple browser alert so the engine works without
  // requiring an extra notification element in the HTML.
  window.alert(message);
}

