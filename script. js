function renderLatestMatch() {
  if (!lastMatch) {
    safeText("matchPerformance", "Play your first match to see your performance.");
    return;
  }

  const match = lastMatch;
  safeText(
    "matchResult",
    `${match.homeName} ${match.homeGoals}–${match.awayGoals} ${match.awayName}`
  );

  safeText(
    "matchPerformance",
    match.minutes > 0
      ? `${match.minutes} minutes | ${match.goals} goals | ${match.assists} assists | Rating ${match.rating}`
      : "You did not play in this match."
  );
}

function renderTrophies() {
  const element = $("trophies");
  if (!element) return;

  if (!player.trophies.length) {
    element.textContent = "No trophies yet. Keep working!";
    return;
